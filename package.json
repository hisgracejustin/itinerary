{
  "name": "itinerary",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/copy-pdf-worker.mjs",
    "build": "next build",
    "prebuild:lowmem": "npm run prebuild",
    "build:lowmem": "SKIP_TYPECHECK=1 NODE_OPTIONS='--max-old-space-size=1024' NEXT_PRIVATE_MAX_WORKERS=1 next build",
    "start": "next start",
    "start:cf": "ALLOW_PGLITE=1 next start -p 5173 -H 0.0.0.0",
    "cf": "npm run typecheck && npm test && npm run build:lowmem && npm run start:cf",
    "lint": "eslint",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:deploy": "node scripts/migrate.mjs",
    "db:infer-timezones": "node scripts/infer-timezones.mjs"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electric-sql/pglite": "^0.5.3",
    "@paralleldrive/cuid2": "^3.3.0",
    "drizzle-orm": "^0.45.2",
    "next": "^16.2.11",
    "next-auth": "5.0.0-beta.32",
    "pdfjs-dist": "^4.8.69",
    "pg": "^8.13.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.11.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
